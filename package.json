{
	"name": "rachnix-checkout-fields",
	"private": true,
	"description": "Development tooling for Rachnix Checkout Field Editor for WooCommerce.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build assets/src/index.js --output-path=assets/build",
		"start": "wp-scripts start assets/src/index.js --output-path=assets/build",
		"lint:js": "wp-scripts lint-js assets/src",
		"lint:js:fix": "wp-scripts lint-js assets/src --fix",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:setup": "wp-env run cli wp plugin activate woocommerce && wp-env run cli wp plugin activate rachnix-checkout-fields",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.1.0",
		"@dnd-kit/sortable": "^8.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@wordpress/icons": "^10.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/components": "^28.0.0",
		"@wordpress/element": "^6.0.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/i18n": "^5.0.0",
		"@wordpress/scripts": "^30.0.0",
		"typescript": "^5.8.0"
	}
}
