<?xml version="1.0"?>
<ruleset name="Rachnix Checkout Fields">
	<description>WordPress-Extra with security sniffs, PHP 8.2+ compatibility.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/build/*</exclude-pattern>
	<exclude-pattern>/.specs/*</exclude-pattern>
	<!-- Copies of other plugins' function signatures, for PHPStan only. -->
	<exclude-pattern>/tests/phpstan/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files are PascalCase, not class-foo.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short array syntax is allowed. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>
	<rule ref="WordPress.Security"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- WooCommerce's capabilities and our own (granted at runtime by Security\Capabilities). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_shop_orders"/>
				<element value="rxcf_manage_fields"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="rachnix-checkout-fields"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rxcf"/>
				<element value="Rachnix\CheckoutFields"/>
			</property>
		</properties>
	</rule>

	<!--
		Repositories and migrations are the only code allowed to query our own tables directly.
		Every query there is prepared; reads are cached by FieldCache.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/src/Repository/*</exclude-pattern>
		<exclude-pattern>/src/Core/Migrations/*</exclude-pattern>
		<exclude-pattern>/tests/Integration/*</exclude-pattern>
		<exclude-pattern>/tests/smoke/*</exclude-pattern>
	</rule>

	<!-- Tests run outside WordPress: they define ABSPATH and use plain PHP file functions. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<!-- Tests set WordPress's own globals ($wp_rest_server, $wp_rest_auth_cookie), which cannot carry our prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Tests use PHPUnit naming and need no escaping. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
